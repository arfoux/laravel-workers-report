---
import Base from '../layouts/Base.astro';
import CensusGrid from '../components/CensusGrid.astro';
import Stat from '../components/Stat.astro';
import { pct, number, headline, features, constructs } from '../lib/report.js';

const total = headline.constructs.audited;
const compileShare = pct(headline.constructs.compiles, total);

const areas = features.reduce((acc, row) => {
  acc[row.area] ??= { name: row.area, fits: 0, soft: 0, hard: 0, total: 0 };
  acc[row.area].total += 1;
  if (row.klass === 'fits') acc[row.area].fits += 1;
  else if (row.klass === 'soft') acc[row.area].soft += 1;
  else acc[row.area].hard += 1;
  return acc;
}, {});
const areaList = Object.values(areas);

const platformRows = features.filter((row) => row.klass !== 'fits').slice(0, 12);
---

<Base
  title={`laravel-workers report: ${number(headline.constructs.compiles)} of ${number(total)} audited constructs compile`}
  description="Every route of a Laravel app gets a compiled handler, a snapshot or a port; everything the compiler cannot carry fails the build. The numbers, the gaps and the ledger, extracted from the repository."
>
  <section class="hero">
    <div class="shell hero__grid">
      <div>
        <p class="verdict">
          <span class="verdict__value">{headline.verdict.badge}</span>
          <span class="muted">the verdict badge in README.md; CI heads its pull-request comment{' '}<code>{headline.verdict.heading}</code></span>
        </p>
        <h1>{number(headline.constructs.compiles)} of {number(total)} audited constructs compile</h1>
        <p class="lede">
          A Laravel app is compiled to a plain JavaScript Worker at build time: no PHP and no WASM at
          the edge. What the compiler cannot carry does not degrade quietly, it fails the build. Below
          is the whole census behind that claim, with the file each number came from.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="/constructs/">Read the census</a>
          <a class="button" href="/gaps/">What fails loud</a>
          <a class="button" href="https://github.com/arfoux/laravel-workers">Repository</a>
        </div>
      </div>

      <figure class="hero__figure">
        <div class="grid__head">
          <span class="grid__title">the census, {number(total)} cells</span>
          <span class="count">
            {number(headline.constructs.compiles)} compile · {number(headline.constructs.failsLoud)} fail loud · {number(headline.constructs.documented)} documented
          </span>
        </div>
        <ul class="cells cell-grid" aria-hidden="true">
          {constructs.map((row) => (
            <li class="mini" data-verdict={row.verdict}></li>
          ))}
        </ul>
        <ul class="legend">
          <li><span class="swatch" style="background:var(--compiles)"></span>compiles</li>
          <li><span class="swatch" style="background:var(--blocked)"></span>fails loud</li>
          <li><span class="swatch" style="background:var(--documented)"></span>documented</li>
        </ul>
        <figcaption class="small muted">
          One cell per construct audited in <code>tools/constructs.json</code>.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section shell" aria-labelledby="numbers-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">the numbers</p>
        <h2 id="numbers-title">Four tallies, one source each</h2>
      </div>
      <p>
        Each figure is regenerated by <code>scripts/extract-lw.mjs</code> from the file the repository
        itself publishes it in, and the site fails its own check when a figure drifts.
      </p>
    </div>

    <div class="cols cols--halves">
      <div class="panel">
        <div class="stats">
          <Stat count={headline.constructs.compiles} label="constructs compile" verdict="compiles" />
          <Stat count={headline.constructs.failsLoud} label="fail loud (never silent)" verdict="fails-loud" />
          <Stat count={headline.constructs.documented} label="documented build-level" verdict="documented" />
        </div>
        <p class="small muted">
          {compileShare}% of the {number(total)} constructs audited in <code>tools/constructs.json</code>,
          tallied the same way <code>tools/docs-counts.mjs</code> tallies them into README.
        </p>
      </div>

      <div class="panel">
        <div class="stats">
          <Stat count={headline.facades.classified} label={`of ${headline.facades.total} Laravel 13 facades classified`} verdict="compiles" />
          <Stat count={headline.corpus.identical} label="Blade cases byte-identical vs PHP 8.3" verdict="compiles" />
          <Stat count={headline.docs.pages} label="Laravel docs pages with a verdict" verdict="compiles" />
        </div>
        <p class="small muted">
          The facade census counts the vendored <code>Illuminate/Support/Facades</code> directory; the
          docs figure is the row count of the coverage index in <code>MAP.md</code> section C, which
          allows no blank verdict.
        </p>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="grid-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">one cell, one construct</p>
        <h2 id="grid-title">The census as a field</h2>
      </div>
      <p>
        Filter by verdict, or click a cell for what it is and why it lands there. Keyboard: tab to a
        cell, then the arrow keys move through the visible ones.
      </p>
    </div>

    <CensusGrid constructs={constructs} />
  </section>

  <section class="section shell" aria-labelledby="areas-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">by area</p>
        <h2 id="areas-title">Where the wall is</h2>
      </div>
      <p>
        The feature map in <code>MAP.md</code> section 5, one row per Laravel capability. Rows class
        themselves as fits, documented trade, or platform wall.
      </p>
    </div>

    <div class="table-wrap">
      <table>
        <caption>{number(features.length)} rows from MAP.md §5, grouped by area.</caption>
        <thead>
          <tr>
            <th scope="col">area</th>
            <th scope="col">rows</th>
            <th scope="col">fits</th>
            <th scope="col">documented trade</th>
            <th scope="col">platform wall</th>
          </tr>
        </thead>
        <tbody>
          {areaList.map((area) => (
            <tr>
              <th scope="row">{area.name}</th>
              <td class="mono">{area.total}</td>
              <td class="mono">{area.fits}</td>
              <td class="mono">{area.soft}</td>
              <td class="mono">{area.hard}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section shell" aria-labelledby="read-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">read next</p>
        <h2 id="read-title">Four ways into the same evidence</h2>
      </div>
      <p>The pages are ordered the way an adoption decision is made.</p>
    </div>

    <ul class="list">
      {[
        { href: '/coverage/', title: 'coverage', blurb: `The ${number(headline.docs.pages)} Laravel documentation pages, each with the verdict the project gives it, and the CPU measurements that set the budget.` },
        { href: '/gaps/', title: 'gaps', blurb: `The ${number(headline.constructs.failsLoud)} constructs that refuse to compile, why they refuse, and the escape hatch published for each one.` },
        { href: '/ledger/', title: 'ledger', blurb: 'The shape of the project\'s own audit ledger: how many suggestions it holds, at what severity, and how many are closed.' },
        { href: '/method/', title: 'method', blurb: 'How every number here is produced, what was measured on this machine, and what could not be verified.' },
        { href: '/report/', title: 'report', blurb: 'The same extracted data on one page, with nothing behind an interaction, for reading straight through.' },
      ].map((entry) => (
        <li>
          <div class="list__head">
            <a class="list__title" href={entry.href}>{entry.title}</a>
          </div>
          <p class="small muted">{entry.blurb}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
